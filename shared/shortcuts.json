          "Mod",
          "Alt"
        ],
        "key": "ArrowRight"
      },
      "platform": {
        "windows": {
          "mods": [
            "Mod",
            "Alt"
          ],
          "key": "PageDown"
        },
        "linux": {
          "mods": [
            "Mod",
            "Alt"
          ],
          "key": "PageDown"
        }
      }
    },
