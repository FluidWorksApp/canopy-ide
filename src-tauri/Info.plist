<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged into the app bundle's Info.plist by tauri-build. Without the usage
  string macOS kills the process the moment dictation opens the microphone,
  instead of showing the permission prompt.
-->
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Canopy uses local-network access for direct, encrypted connections to teammates. When a direct connection is unavailable, encrypted messages use the relay.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Canopy uses the microphone for voice dictation. Audio is transcribed locally on this device and never uploaded.</string>
  <!-- Previews load from http://p-<hash>.localhost. Without this exception a
       bundled app's WebKit refuses them and the frame stays blank. -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSExceptionDomains</key>
    <dict>
      <key>localhost</key>
      <dict>
        <key>NSIncludesSubdomains</key>
        <true/>
        <key>NSExceptionAllowsInsecureHTTPLoads</key>
        <true/>
      </dict>
    </dict>
  </dict>
</dict>
</plist>
