                    <RegistryValue Name=".clj" Type="string" Value="" />
                    <RegistryValue Name=".nim" Type="string" Value="" />
                    <RegistryValue Name=".jl" Type="string" Value="" />
                    <RegistryValue Name=".r" Type="string" Value="" />
                    <RegistryValue Name=".vue" Type="string" Value="" />
                    <RegistryValue Name=".svelte" Type="string" Value="" />
                    <RegistryValue Name=".astro" Type="string" Value="" />
                    <RegistryValue Name=".ini" Type="string" Value="" />
                    <RegistryValue Name=".cfg" Type="string" Value="" />
                    <RegistryValue Name=".conf" Type="string" Value="" />
                    <RegistryValue Name=".env" Type="string" Value="" />
                    <RegistryValue Name=".properties" Type="string" Value="" />
                    <RegistryValue Name=".lock" Type="string" Value="" />
                    <RegistryValue Name=".jsonc" Type="string" Value="" />
                    <RegistryValue Name=".json5" Type="string" Value="" />
                    <RegistryValue Name=".mdx" Type="string" Value="" />
                    <RegistryValue Name=".graphql" Type="string" Value="" />
                    <RegistryValue Name=".gql" Type="string" Value="" />
                    <RegistryValue Name=".proto" Type="string" Value="" />
                    <RegistryValue Name=".tf" Type="string" Value="" />
                    <RegistryValue Name=".tfvars" Type="string" Value="" />
                    <RegistryValue Name=".hcl" Type="string" Value="" />
                    <RegistryValue Name=".gradle" Type="string" Value="" />
                    <RegistryValue Name=".cmake" Type="string" Value="" />
                    <RegistryValue Name=".nix" Type="string" Value="" />
                    <RegistryValue Name=".dockerfile" Type="string" Value="" />
                    <RegistryValue Name=".gitignore" Type="string" Value="" />
                    <RegistryValue Name=".editorconfig" Type="string" Value="" />
                    <RegistryValue Name=".ps1" Type="string" Value="" />
                    <RegistryValue Name=".bat" Type="string" Value="" />
                    <RegistryValue Name=".cmd" Type="string" Value="" />
                    </RegistryKey>
                </RegistryKey>
                <RegistryValue Root="HKLM" Key="Software\Classes\.txt\OpenWithProgids" Name="Canopy.SourceFile" Type="string" Value="" />
                <RegistryValue Root="HKLM" Key="Software\Classes\.log\OpenWithProgids" Name="Canopy.SourceFile" Type="string" Value="" />
                <RegistryValue Root="HKLM" Key="Software\Classes\.md\OpenWithProgids" Name="Canopy.SourceFile" Type="string" Value="" />
                <RegistryValue Root="HKLM" Key="Software\Classes\.markdown\OpenWithProgids" Name="Canopy.SourceFile" Type="string" Value="" />
                <RegistryValue Root="HKLM" Key="Software\Classes\.json\OpenWithProgids" Name="Canopy.SourceFile" Type="string" Value="" />
                <RegistryValue Root="HKLM" Key="Software\Classes\.xml\OpenWithProgids" Name="Canopy.SourceFile" Type="string" Value="" />
                <RegistryValue Root="HKLM" Key="Software\Classes\.yml\OpenWithProgids" Name="Canopy.SourceFile" Type="string" Value="" />
                <RegistryValue Root="HKLM" Key="Software\Classes\.yaml\OpenWithProgids" Name="Canopy.SourceFile" Type="string" Value="" />
                <RegistryValue Root="HKLM" Key="Software\Classes\.toml\OpenWithProgids" Name="Canopy.SourceFile" Type="string" Value="" />
                <RegistryValue Root="HKLM" Key="Software\Classes\.csv\OpenWithProgids" Name="Canopy.SourceFile" Type="string" Value="" />
                <RegistryValue Root="HKLM" Key="Software\Classes\.css\OpenWithProgids" Name="Canopy.SourceFile" Type="string" Value="" />
                <RegistryValue Root="HKLM" Key="Software\Classes\.js\OpenWithProgids" Name="Canopy.SourceFile" Type="string" Value="" />
