<?xml version="1.0" encoding="utf-8"?>
<!--
  Lists Canopy under Explorer's "Open with" for text and source files without
  ever taking over a default; the MSI counterpart of open-with.nsh. Tauri's
  `bundle.fileAssociations` is not used on Windows because its
  `<ProgId Advertise="yes">` rewrites `Software\Classes\.<ext>`'s default
  value, making Canopy the handler for every listed extension.

  Tauri's MSI is per-machine (main.wxs: InstallScope="perMachine", deep links
  under HKLM\Software\Classes), so this writes to HKLM too. Windows Installer
  removes every value here on uninstall. The ProgID and Applications keys are
  ours alone and are deleted whole; the shared `.<ext>\OpenWithProgids` keys
  only lose our value.

  Tauri passes this file to candle as is (not through its templates), so the
  executable name is spelled out: "canopy.exe" is the Cargo binary name, which
  Tauri keeps unless `mainBinaryName` is set. `[!Path]` is the full path of
  main.wxs's File Id="Path", the installed main executable.

  The extension list must match open-with.nsh.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
<?if $(sys.BUILDARCH)="x86"?>
    <?define CanopyWin64 = "no" ?>
<?else?>
    <?define CanopyWin64 = "yes" ?>
<?endif?>
    <Fragment>
        <DirectoryRef Id="INSTALLDIR">
            <Component Id="CanopyOpenWith" Guid="5B313577-4FEA-4882-9430-344DBA09FFBB" Win64="$(var.CanopyWin64)">
                <RegistryKey Root="HKLM" Key="Software\Classes\Canopy.SourceFile" ForceDeleteOnUninstall="yes">
                    <RegistryValue Type="string" Value="Source file" KeyPath="yes" />
                    <RegistryKey Key="DefaultIcon">
                        <RegistryValue Type="string" Value="&quot;[!Path]&quot;,0" />
                    </RegistryKey>
                    <RegistryKey Key="shell\open\command">
                        <RegistryValue Type="string" Value="&quot;[!Path]&quot; &quot;%1&quot;" />
                    </RegistryKey>
                </RegistryKey>
                <RegistryKey Root="HKLM" Key="Software\Classes\Applications\canopy.exe" ForceDeleteOnUninstall="yes">
                    <RegistryValue Name="FriendlyAppName" Type="string" Value="Canopy" />
                    <RegistryKey Key="shell\open\command">
                        <RegistryValue Type="string" Value="&quot;[!Path]&quot; &quot;%1&quot;" />
                    </RegistryKey>
                    <RegistryKey Key="SupportedTypes">
                    <RegistryValue Name=".txt" Type="string" Value="" />
                    <RegistryValue Name=".log" Type="string" Value="" />
                    <RegistryValue Name=".md" Type="string" Value="" />
                    <RegistryValue Name=".markdown" Type="string" Value="" />
                    <RegistryValue Name=".json" Type="string" Value="" />
                    <RegistryValue Name=".xml" Type="string" Value="" />
                    <RegistryValue Name=".yml" Type="string" Value="" />
                    <RegistryValue Name=".yaml" Type="string" Value="" />
                    <RegistryValue Name=".toml" Type="string" Value="" />
                    <RegistryValue Name=".csv" Type="string" Value="" />
                    <RegistryValue Name=".css" Type="string" Value="" />
                    <RegistryValue Name=".js" Type="string" Value="" />
                    <RegistryValue Name=".mjs" Type="string" Value="" />
                    <RegistryValue Name=".cjs" Type="string" Value="" />
                    <RegistryValue Name=".ts" Type="string" Value="" />
                    <RegistryValue Name=".tsx" Type="string" Value="" />
                    <RegistryValue Name=".mts" Type="string" Value="" />
                    <RegistryValue Name=".cts" Type="string" Value="" />
                    <RegistryValue Name=".jsx" Type="string" Value="" />
                    <RegistryValue Name=".py" Type="string" Value="" />
                    <RegistryValue Name=".rs" Type="string" Value="" />
                    <RegistryValue Name=".go" Type="string" Value="" />
                    <RegistryValue Name=".c" Type="string" Value="" />
                    <RegistryValue Name=".h" Type="string" Value="" />
                    <RegistryValue Name=".cc" Type="string" Value="" />
                    <RegistryValue Name=".cpp" Type="string" Value="" />
                    <RegistryValue Name=".cxx" Type="string" Value="" />
                    <RegistryValue Name=".hh" Type="string" Value="" />
                    <RegistryValue Name=".hpp" Type="string" Value="" />
                    <RegistryValue Name=".hxx" Type="string" Value="" />
                    <RegistryValue Name=".java" Type="string" Value="" />
                    <RegistryValue Name=".kt" Type="string" Value="" />
                    <RegistryValue Name=".kts" Type="string" Value="" />
                    <RegistryValue Name=".cs" Type="string" Value="" />
                    <RegistryValue Name=".rb" Type="string" Value="" />
                    <RegistryValue Name=".php" Type="string" Value="" />
                    <RegistryValue Name=".sh" Type="string" Value="" />
                    <RegistryValue Name=".bash" Type="string" Value="" />
                    <RegistryValue Name=".zsh" Type="string" Value="" />
                    <RegistryValue Name=".sql" Type="string" Value="" />
                    <RegistryValue Name=".mk" Type="string" Value="" />
                    <RegistryValue Name=".scala" Type="string" Value="" />
                    <RegistryValue Name=".dart" Type="string" Value="" />
