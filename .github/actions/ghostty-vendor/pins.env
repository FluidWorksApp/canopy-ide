# The ONE place the Ghostty pins live. Sourced by vendor.sh (bash). A pin bump is
# an edit to this file only; the workflows never repeat these values.
#
# Today: libghostty-vt-sys 0.2.2 -> ghostty a887df42c56f6de86c0fe6da9c4eeca37931e083,
# Zig 0.15.2 (the Zig install step lives in the workflows; its version goes into
# the cache key at run time, read from `zig version`).
#
# HOW TO BUMP (after changing libghostty-vt in the term crates' Cargo.toml/lock):
#   1. SYS_CRATE_VERSION: the new libghostty-vt-sys version from Cargo.lock.
#   2. GHOSTTY_COMMIT: `const GHOSTTY_COMMIT` in that crate's build.rs
#      (crates.io source: https://static.crates.io/crates/libghostty-vt-sys/libghostty-vt-sys-<ver>.crate).
#   3. The three checksums: run `RECOMPUTE=1 bash .github/actions/ghostty-vendor/vendor.sh ensure`
#      with Zig on PATH (needs git, network, about 700 MB of scratch in $RUNNER_TEMP or
#      $TMPDIR), or just push and copy the "got" values the failing job prints.
#   4. Update the size comments below (informational).
# Changing GHOSTTY_COMMIT changes the cache key, so the next run refetches and re-saves.
# A Cargo.lock whose libghostty-vt-sys differs from SYS_CRATE_VERSION fails the
# job at once: with GHOSTTY_SOURCE_DIR set the crate would silently build the
# pinned source, not its own.

SYS_CRATE_VERSION=0.2.2
GHOSTTY_REPO=https://github.com/ghostty-org/ghostty.git
GHOSTTY_COMMIT=a887df42c56f6de86c0fe6da9c4eeca37931e083

# sha256 of `git archive --format=tar HEAD` of that commit (host independent;
# checked right after the fetch, before .git is removed). Source tree is 103 MB.
GHOSTTY_SRC_ARCHIVE_SHA256=c06531802ab5d241c730f66b99880edb39b2aa43d5b87b868298d431547d3c82

# sha256 of the sorted per-file manifest of the extracted tree, after removing the
# top-level CLAUDE.md symlink (a plain file on Windows). 5768 files. Checked on every run,
# including after a cache restore.
#   (cd src && find . -type f | LC_ALL=C sort | tr '\n' '\0' | xargs -0 sha256sum) | sha256sum
GHOSTTY_SRC_MANIFEST_SHA256=3daf2f34fbbb8ff6f33ef66d0f4e9b1d004593ca9090fd993b9f500e7d953855

# Zig package cache (`zig build --fetch=all`, its `p/` dir = GHOSTTY_ZIG_SYSTEM_DIR):
# 565 MB, 36 package dirs, 29991 files. Same manifest recipe as above, run inside p/.
# Recorded in PR #809 SPIKE.md ("Build proof"; its GNU-tar sha256 was
# 658eb131516e85bbb01a64e3da337d1d16df7828d1fbe482703a9f90cbb1538c, not used here
# because macOS tar cannot do --sort).
GHOSTTY_ZIG_MANIFEST_SHA256=1586a0d54a3d83ae4ceb4811f9721fc1645730cb29fc919225ba353b9dcfec9a

# Bump to throw away every saved cache without changing any pin.
CACHE_VERSION=1
