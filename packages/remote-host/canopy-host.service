[Unit]
Description=Canopy shared execution host
After=network-online.target docker.service canopy-network.service
Requires=docker.service canopy-network.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=canopy-host
SupplementaryGroups=docker
WorkingDirectory=/opt/canopy-host
# Root-owned shared runtime files are created (or their owner and mode repaired)
# here, never by whichever process runs first. '+' runs this one step as root.
ExecStartPre=+/usr/bin/systemd-tmpfiles --create /opt/canopy-host/canopy-runtime.tmpfiles.conf
Environment=CANOPY_HOST_CONFIG=/etc/canopy-host/host.json
Environment=CANOPY_HOST_STATE=/var/lib/canopy-host
Environment=CANOPY_WORKSPACE_SCRATCH_ROOT=/var/lib/canopy-scratch
# Lives on the VM root disk, outside /srv/canopy. StateDirectory remains
# writable under ProtectSystem even when managed bootstrap resets ReadWritePaths.
StateDirectory=canopy-scratch
StateDirectoryMode=0711
ExecStart=/usr/bin/node /opt/canopy-host/gateway.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
MemoryMax=512M
TasksMax=128
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/canopy-host

[Install]
WantedBy=multi-user.target
